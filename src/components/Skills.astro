---
import SectionHeading from './SectionHeading.astro';
import Chip from './Chip.astro';
import { useTranslations, type Lang } from '../i18n';
import type { Profile } from '../data/profile';

interface Props {
  lang: Lang;
  profile: Profile;
  eyebrow: string;
}
const { lang, profile, eyebrow } = Astro.props;
const t = useTranslations(lang);
const many = profile.skills.length >= 6;
---

<section id="skills" class="py-20 md:py-28" aria-labelledby="skills-title">
  <div class="container-page">
    <SectionHeading id="skills-title" eyebrow={eyebrow} title={t('skills.title')} lead={t('skills.lead')} />
    <div class:list={['mt-10 grid gap-5 md:mt-14 md:grid-cols-2 md:gap-6', many && 'lg:grid-cols-3']}>
      {
        profile.skills.map((group, i) => (
          <section
            class="md:rounded-lg md:border md:border-border md:bg-surface md:p-6 md:shadow-soft"
            aria-labelledby={`skills-group-${i}`}
            data-reveal
            style={`--reveal-delay: ${Math.min(i * 80, 400)}ms`}
          >
            <h3 id={`skills-group-${i}`} class="font-sans text-sm font-semibold tracking-wide text-muted uppercase">
              {group.name}
            </h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <li>
                  <Chip icon={skill.icon} interactive>
                    {skill.name}
                  </Chip>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>
