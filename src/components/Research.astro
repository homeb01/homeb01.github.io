---
import BookOpen from '@lucide/astro/icons/book-open';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import SectionHeading from './SectionHeading.astro';
import { useTranslations, type Lang } from '../i18n';
import { formatYearMonth } from '../lib/format';
import type { Profile } from '../data/profile';

interface Props {
  lang: Lang;
  profile: Profile;
  eyebrow: string;
}
const { lang, profile, eyebrow } = Astro.props;
const t = useTranslations(lang);
const publications = profile.publications ?? [];

/** The site owner's name is emphasized in the author list (accent-insensitive match). */
const plain = (s: string) => s.normalize('NFD').replace(/\p{Diacritic}/gu, '').trim().toLowerCase();
const isOwner = (author: string) => plain(author) === plain(profile.name);
---

<section id="research" class="py-20 md:py-28" aria-labelledby="research-title">
  <div class="container-page">
    <SectionHeading id="research-title" eyebrow={eyebrow} title={t('research.title')} lead={t('research.lead')} />

    <ul class="mt-10 grid gap-5 md:mt-14 md:gap-6">
      {
        publications.map((pub, i) => (
          <li class="rounded-lg border border-border bg-surface p-5 shadow-soft md:p-8" data-reveal style={`--reveal-delay: ${Math.min(i * 80, 400)}ms`}>
            <article class="flex items-start gap-4 md:gap-6">
              <span class="grid size-10 shrink-0 place-items-center rounded-full bg-accent-soft text-accent-soft-fg" aria-hidden="true">
                <BookOpen class="size-5" />
              </span>
              <div class="min-w-0">
                <p class="text-sm text-muted tabular-nums">
                  <span class="font-medium text-accent">{pub.venue}</span>
                  <span> · </span>
                  <time datetime={pub.date}>{formatYearMonth(pub.date, lang)}</time>
                </p>
                <h3 class="mt-2 text-xl font-semibold text-balance md:text-[1.375rem]">{pub.title}</h3>
                <p class="mt-2 text-sm text-muted">
                  <span class="sr-only">{t('research.authors')}: </span>
                  {/* Kept on one line so no whitespace sneaks in before the commas. */}
                  {pub.authors.map((author, j) => <>{j > 0 && ', '}{isOwner(author) ? <strong class="font-semibold text-fg">{author}</strong> : author}</>)}
                </p>
                {pub.description && <p class="mt-3 max-w-prose text-muted">{pub.description}</p>}
                {pub.url && (
                  <a
                    href={pub.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-4 inline-flex min-h-11 items-center gap-1 font-medium text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
                  >
                    {t('research.read')}
                    <ArrowUpRight class="size-4" aria-hidden="true" />
                    <span class="sr-only">{t('a11y.newTab')}</span>
                  </a>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
