---
import Mail from '@lucide/astro/icons/mail';
import FileText from '@lucide/astro/icons/file-text';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import BrandIcon from './BrandIcon.astro';
import { useTranslations, type Lang } from '../i18n';
import type { Profile } from '../data/profile';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
  profile: Profile;
  eyebrow: string;
}
const { lang, profile, eyebrow } = Astro.props;
const t = useTranslations(lang);
const { email, github, linkedin, cvPdf } = profile.links;
const newTab = t('a11y.newTab');
---

<section id="contact" class="py-20 md:py-28" aria-labelledby="contact-title">
  <div class="container-page">
    <div class="glow grid gap-10 rounded-xl border border-border bg-surface-2 p-8 md:p-12 lg:grid-cols-12 lg:items-center lg:p-16" data-reveal>
      <div class="lg:col-span-7">
        <SectionHeading id="contact-title" eyebrow={eyebrow} title={t('contact.title')} lead={t('contact.lead')} />
      </div>
      <div class="flex flex-col gap-3 lg:col-span-5 lg:items-stretch">
        {
          email && (
            <Button href={`mailto:${email}`} variant="primary">
              <Mail class="size-4" aria-hidden="true" />
              {t('contact.email')}
            </Button>
          )
        }
        <Button href={github} variant={email ? 'ghost' : 'primary'} external newTabLabel={newTab} rel="me">
          <BrandIcon name="github" class="size-4" />
          GitHub
        </Button>
        {
          linkedin && (
            <Button href={linkedin} variant="ghost" external newTabLabel={newTab} rel="me">
              <BrandIcon name="linkedin" class="size-4" />
              LinkedIn
            </Button>
          )
        }
        {
          cvPdf && (
            <Button href={withBase(cvPdf)} variant="ghost" external newTabLabel={newTab}>
              <FileText class="size-4" aria-hidden="true" />
              {t('contact.cv')}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>
