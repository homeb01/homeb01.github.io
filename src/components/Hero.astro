---
import { Image } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Button from './Button.astro';
import BrandIcon from './BrandIcon.astro';
import CodingScene from './CodingScene.astro';
import { useTranslations, type Lang } from '../i18n';
import type { Profile } from '../data/profile';

interface Props {
  lang: Lang;
  profile: Profile;
}
const { lang, profile } = Astro.props;
const t = useTranslations(lang);

const social = [
  { name: 'GitHub', icon: 'github', href: profile.links.github },
  ...(profile.links.linkedin ? [{ name: 'LinkedIn', icon: 'linkedin', href: profile.links.linkedin }] : []),
];
---

<section class="glow relative" aria-labelledby="hero-title">
  <div class="container-page grid min-h-[calc(100svh-4rem)] grid-cols-1 items-center gap-y-8 pt-16 pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)_minmax(0,0.85fr)] lg:gap-x-10 xl:gap-x-16">
    <div class="hidden lg:block" data-reveal style="--reveal-delay: 240ms">
      <CodingScene lang={lang} initials={profile.initials} />
    </div>

    <div class="lg:col-start-2 lg:row-start-1">
      <p class="eyebrow" data-reveal>{t('hero.greeting')}</p>
      <h1 id="hero-title" class="mt-4 text-4xl font-semibold md:text-7xl lg:text-4xl xl:text-5xl 2xl:text-6xl" data-reveal style="--reveal-delay: 80ms">
        {profile.name}
        <span class="mt-1 block text-gradient pb-1">{profile.headline}</span>
      </h1>
      <p class="mt-6 text-lg font-medium md:text-xl" data-reveal style="--reveal-delay: 160ms">{profile.role}</p>
      <p class="mt-3 max-w-prose text-lg text-muted md:text-xl" data-reveal style="--reveal-delay: 160ms">{profile.tagline}</p>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center" data-reveal style="--reveal-delay: 240ms">
        <Button href="#projects" variant="primary">
          {t('hero.ctaProjects')}
          <ArrowRight class="size-4 transition-transform duration-[250ms] ease-out-soft group-hover:translate-x-0.5" aria-hidden="true" />
        </Button>
        <Button href="#contact" variant="ghost">{t('hero.ctaContact')}</Button>
        <ul class="flex items-center gap-1 sm:ml-2">
          {
            social.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer me"
                  class="inline-flex size-11 items-center justify-center rounded-full text-muted transition duration-[150ms] ease-out-soft hover:-translate-y-0.5 hover:bg-surface-2 hover:text-fg"
                >
                  <BrandIcon name={s.icon} class="size-5" />
                  <span class="sr-only">
                    {s.name} {t('a11y.newTab')}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      profile.photo ? (
        <div class="order-first mx-0 w-32 md:w-40 lg:order-none lg:col-start-3 lg:row-start-1 lg:mx-auto lg:w-full lg:max-w-[18rem]" data-reveal style="--reveal-delay: 320ms">
          <div class="relative">
            <div class="absolute inset-0 rotate-6 rounded-xl bg-accent-2-soft" aria-hidden="true" />
            <div class="relative -rotate-2 overflow-hidden rounded-xl border border-border bg-[linear-gradient(160deg,var(--color-accent-soft),var(--color-accent-2-soft))] shadow-lift">
              <Image
                src={profile.photo.src}
                alt={profile.photo.alt}
                width={472}
                height={591}
                widths={[256, 384, 472]}
                sizes="(min-width: 1024px) 18rem, 10rem"
                class="block aspect-[4/5] w-full object-cover object-top"
                loading="eager"
              />
            </div>
          </div>
        </div>
      ) : (
        <div class="hidden lg:col-start-3 lg:row-start-1 lg:block" data-reveal style="--reveal-delay: 320ms">
          <div class="relative mx-auto aspect-square w-full max-w-sm" aria-hidden="true">
            <div class="absolute inset-0 rotate-6 rounded-xl bg-accent-2-soft" />
            <div class="absolute inset-0 -rotate-3 rounded-xl border border-border bg-[linear-gradient(135deg,var(--color-accent),var(--color-accent-2))] shadow-lift" />
            <div class="absolute inset-0 grid place-items-center">
              <span class="font-display text-6xl font-semibold tracking-tight text-accent-fg xl:text-7xl">{profile.initials}</span>
            </div>
          </div>
        </div>
      )
    }
  </div>

  <a
    href="#about"
    class="absolute bottom-6 left-1/2 hidden size-11 -translate-x-1/2 items-center justify-center rounded-full text-muted transition-colors hover:text-fg md:inline-flex"
    aria-label={t('hero.scroll')}
  >
    <ChevronDown class="size-6 motion-safe:animate-bounce" aria-hidden="true" />
  </a>
</section>
