---
import Interests from './Interests.astro';
import PersonalGallery from './PersonalGallery.astro';
import { useTranslations, type Lang } from '../i18n';
import type { PersonalSection } from '../data/profile';
import { withAge } from '../lib/age';

interface Props {
  lang: Lang;
  personal: PersonalSection;
}
const { lang, personal } = Astro.props;
const t = useTranslations(lang);
---

<section id="beyond" class="mt-20 border-t border-border pt-16 md:mt-28 md:pt-20" aria-labelledby="beyond-title">
  <div class="grid grid-cols-12 gap-y-8 md:gap-x-8">
    <header class="col-span-12 md:col-span-4" data-reveal>
      <p class="eyebrow">{personal.eyebrow}</p>
      <h3 id="beyond-title" class="mt-3 text-2xl font-semibold md:text-4xl">{personal.title}</h3>
      {personal.lead && <p class="mt-4 max-w-prose text-lg text-muted">{personal.lead}</p>}
    </header>

    <div class="col-span-12 space-y-10 md:col-span-8">
      {
        personal.intro.length > 0 && (
          <div class="space-y-5" data-reveal style="--reveal-delay: 80ms">
            {personal.intro.map((paragraph) => (
              <p class="max-w-prose text-lg">{withAge(paragraph)}</p>
            ))}
          </div>
        )
      }
      {personal.interests.length > 0 && <Interests title={t('beyond.interests')} items={personal.interests} />}
    </div>
  </div>

  {personal.gallery.length > 0 && <PersonalGallery lang={lang} photos={personal.gallery} />}
</section>
