---
import { Image } from 'astro:assets';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import MapPin from '@lucide/astro/icons/map-pin';
import { useTranslations, type Lang } from '../i18n';
import type { GalleryPhoto } from '../data/profile';

interface Props {
  lang: Lang;
  photos: GalleryPhoto[];
}
const { lang, photos } = Astro.props;
const t = useTranslations(lang);
const total = photos.length;
const slideLabel = (n: number) => t('beyond.slide').replace('{n}', String(n)).replace('{total}', String(total));
/** Candidate widths, never larger than the normalized source (1280 or 1800 px). */
const widthsFor = (w: number) => [...[400, 640, 800, 1080, 1440].filter((x) => x < w), w];
const btn =
  'inline-flex size-11 items-center justify-center rounded-full border border-border-strong text-fg transition duration-[150ms] ease-out-soft hover:border-accent hover:bg-surface-2 aria-disabled:pointer-events-none aria-disabled:opacity-35';
---

<div class="mt-14 md:mt-16" role="region" aria-roledescription="carousel" aria-label={t('beyond.galleryLabel')} data-carousel>
  <div class="flex items-end justify-between gap-4" data-reveal>
    <h4 class="text-sm font-semibold tracking-wider text-muted uppercase">{t('beyond.gallery')}</h4>
    {
      total > 1 && (
        <div class="flex items-center gap-2">
          <p class="mr-1 text-sm text-muted tabular-nums" aria-hidden="true">
            <span class="font-semibold text-fg" data-current>1</span> / {total}
          </p>
          <button type="button" class={btn} aria-label={t('beyond.prev')} aria-disabled="true" data-prev>
            <ChevronLeft class="size-5" aria-hidden="true" />
          </button>
          <button type="button" class={btn} aria-label={t('beyond.next')} data-next>
            <ChevronRight class="size-5" aria-hidden="true" />
          </button>
        </div>
      )
    }
  </div>

  <div
    class="relative -mx-5 mt-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto overscroll-x-contain px-5 pt-1 pb-6 [scrollbar-width:none] md:-mx-8 md:scroll-px-8 md:gap-6 md:px-8 [--edge:1.25rem] [mask-image:linear-gradient(to_right,transparent,#000_var(--edge),#000_calc(100%_-_var(--edge)),transparent)] focus-visible:outline-offset-[-2px] md:[--edge:2rem] [&::-webkit-scrollbar]:hidden"
    tabindex="0"
    data-track
  >
    {
      photos.map((photo, i) => (
        <div
          class="w-[85%] shrink-0 snap-start sm:w-[70%] lg:w-[46%]"
          role="group"
          aria-roledescription="slide"
          aria-label={slideLabel(i + 1)}
          data-slide
        >
          <figure class="relative overflow-hidden rounded-xl border border-border bg-surface-2 shadow-soft">
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={widthsFor(photo.src.width)}
              sizes="(min-width: 1152px) 31rem, (min-width: 1024px) 44vw, (min-width: 640px) 68vw, 85vw"
              class="block aspect-[3/2] w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            {photo.caption && (
              <figcaption class="absolute bottom-3 left-3 inline-flex max-w-[calc(100%-1.5rem)] items-center gap-1.5 rounded-full bg-bg/85 px-3 py-1.5 text-sm font-medium text-fg shadow-soft backdrop-blur-md">
                <MapPin class="size-4 shrink-0 text-accent" aria-hidden="true" />
                <span class="truncate">{photo.caption}</span>
              </figcaption>
            )}
          </figure>
        </div>
      ))
    }
  </div>
</div>

<script>
  // Native scroll-snap carousel: buttons + keyboard + counter. No autoplay.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const current = root.querySelector<HTMLElement>('[data-current]');
    if (!track || slides.length < 2 || !prev || !next) continue;

    const EPS = 4;
    const padding = () => parseFloat(getComputedStyle(track).scrollPaddingLeft) || 0;
    const targets = () => slides.map((s) => s.offsetLeft - padding());
    const maxScroll = () => track.scrollWidth - track.clientWidth;

    const scrollToLeft = (left: number) =>
      track.scrollTo({ left, behavior: reduceMotion.matches ? 'auto' : 'smooth' });

    const step = (dir: 1 | -1) => {
      const x = track.scrollLeft;
      const list = targets();
      const target = dir > 0 ? list.find((p) => p > x + EPS) : list.findLast((p) => p < x - EPS);
      if (target !== undefined) scrollToLeft(Math.min(Math.max(target, 0), maxScroll()));
    };

    const update = () => {
      const x = track.scrollLeft;
      const max = maxScroll();
      let index = 0;
      if (x >= max - EPS) index = slides.length - 1;
      else {
        const list = targets();
        index = list.reduce((best, p, i) => (Math.abs(p - x) < Math.abs(list[best]! - x) ? i : best), 0);
      }
      if (current) current.textContent = String(index + 1);
      prev.setAttribute('aria-disabled', String(x <= EPS));
      next.setAttribute('aria-disabled', String(x >= max - EPS));
    };

    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    track.addEventListener('keydown', (e) => {
      const keys: Record<string, () => void> = {
        ArrowLeft: () => step(-1),
        ArrowRight: () => step(1),
        Home: () => scrollToLeft(0),
        End: () => scrollToLeft(maxScroll()),
      };
      const action = keys[e.key];
      if (action) {
        e.preventDefault();
        action();
      }
    });

    let frame = 0;
    const schedule = () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(update);
    };
    track.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    update();
  }
</script>
