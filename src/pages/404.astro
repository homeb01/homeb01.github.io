---
/**
 * GitHub Pages serves this single /404.html for every missing URL, in both languages.
 * It renders in the default language (English); a tiny inline script switches to the
 * Spanish block when the URL starts with [base]/es/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { defaultLang, langs, localizePath, useTranslations, type Lang } from '../i18n';

// Home of each language, base included: { en: '[base]/', es: '[base]/es/' }.
const homes = Object.fromEntries(langs.map((l) => [l, localizePath('/', l)])) as Record<Lang, string>;
// Prefixes of the non-default languages, checked client-side.
const prefixes = langs.filter((l) => l !== defaultLang).map((l) => [l, homes[l]]);
---

<BaseLayout lang={defaultLang} title="404" description={useTranslations(defaultLang)('notFound.body')} alternates={homes} noindex>
  <section class="glow">
    <div class="container-page flex min-h-[70svh] flex-col items-center justify-center py-20 text-center">
      <p class="text-gradient font-display text-8xl font-semibold tracking-tight md:text-9xl" aria-hidden="true">404</p>
      {
        langs.map((lang) => {
          const t = useTranslations(lang);
          return (
            <div data-lang-block={lang} lang={lang} hidden={lang !== defaultLang}>
              <h1 class="mt-6 text-3xl font-semibold md:text-5xl">{t('notFound.title')}</h1>
              <p class="mx-auto mt-4 max-w-md text-lg text-muted">{t('notFound.body')}</p>
              <Button href={homes[lang]} class="mt-10">
                {t('notFound.cta')}
              </Button>
            </div>
          );
        })
      }
    </div>
  </section>
  <script is:inline define:vars={{ prefixes }}>
    const path = location.pathname;
    const match = prefixes.find(([, prefix]) => path.startsWith(prefix) || path === prefix.slice(0, -1));
    if (match) {
      const lang = match[0];
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-lang-block]').forEach((el) => {
        el.hidden = el.getAttribute('data-lang-block') !== lang;
      });
    }
  </script>
</BaseLayout>
